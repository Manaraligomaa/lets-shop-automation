BASE_URL=https://rahulshettyacademy.com/client
API_URL=https://rahulshettyacademy.com/api/ecom
# Your Let's Shop test account: put the real values in .env (gitignored), never in this file
USER_EMAIL=
USER_PASSWORD=
# Optional: use an installed browser instead of Playwright's Chromium (chrome, msedge)
BROWSER_CHANNEL=
# Optional: Jira site (e.g. https://your-team.atlassian.net) so the report links each test to its Jira issue
JIRA_URL=
# Optional: ASSET_CACHE=off makes every test download the app's scripts and styles again (see utils/asset-cache.ts)

