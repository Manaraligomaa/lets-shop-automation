{
  "story": "AI-14",
  "title": "Reset a forgotten password",
  "resetRoute": "#/auth/password-new",
  "openFromLogin": [
    { "jira": "AI-56", "tc": "TC-PWD-14-01", "name": "Forgot password link opens the reset page", "tags": ["@regression"] }
  ],
  "emptyForm": [
    { "jira": "AI-58", "tc": "TC-PWD-14-03", "name": "Empty reset form is rejected", "tags": ["@regression", "@negative"],
      "requiredMessagePattern": "is required" }
  ],
  "mismatch": [
    { "jira": "AI-59", "tc": "TC-PWD-14-04", "name": "Mismatched new passwords are rejected", "tags": ["@regression", "@negative"],
      "email": "{{env.USER_EMAIL}}", "password": "Newpass1@", "confirmPassword": "Newpass1#",
      "loginEmail": "{{env.USER_EMAIL}}", "loginPassword": "{{env.USER_PASSWORD}}", "dashboardRoute": "#/dashboard/dash" }
  ],
  "unregisteredEmail": [
    { "jira": "AI-60", "tc": "TC-PWD-14-05", "name": "Unregistered email is rejected", "tags": ["@regression", "@negative"],
      "email": "no.such.user.test@example.com", "password": "Newpass1@", "confirmPassword": "Newpass1@" }
  ]
}
